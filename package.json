{
  "name": "libretv-mac",
  "version": "2.21.0",
  "private": true,
  "description": "LibreTV 私人影视库 macOS 桌面版（基于 LibreSpark/LibreTV）",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app:dev": "npm run app:prepare && electron .",
    "app:prepare": "DOCKER_BUILD=1 next build && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public",
    "app:dist": "npm run app:prepare && electron-builder --mac"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.12",
    "artplayer": "^5.2.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.8.2",
    "mux.js": "^6.3.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.25",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "productName": "LibreTV",
  "main": "electron/main.js",
  "build": {
    "appId": "local.libretv.mac",
    "productName": "LibreTV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "electron/app.env",
        "to": "app.env"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "public/icons/icon-512.png",
      "identity": null
    }
  }
}
